<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>WinScope</AssemblyName>
    <RootNamespace>WinScope</RootNamespace>
    <Version>1.1.0</Version>
    <Product>WinScope</Product>
    <Description>Performance history, network by app, plain-English event log and storage cleanup for Windows</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon />
    <TieredPGO>true</TieredPGO>
    <!-- The native parsers read x64 layouts; never run as 32-bit. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 produces a single self-contained WinScope.exe -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
