<UserControl x:Class="WinScope.Modules.Performance.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="200"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="2*" MinHeight="140"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Toolbar: time window, live, status -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10" LastChildFill="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Show the last" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="Win5" Content="5 min" GroupName="perfWindow" Style="{StaticResource ChipRadio}" IsChecked="True"/>
                <RadioButton x:Name="Win15" Content="15 min" GroupName="perfWindow" Style="{StaticResource ChipRadio}"/>
                <RadioButton x:Name="Win60" Content="1 h" GroupName="perfWindow" Style="{StaticResource ChipRadio}"/>
                <RadioButton x:Name="Win120" Content="2 h" GroupName="perfWindow" Style="{StaticResource ChipRadio}"/>
                <Border Width="1" Background="{StaticResource LineBrush}" Margin="8,3,12,3"/>
                <ToggleButton x:Name="LiveChip" Style="{StaticResource Chip}" IsChecked="True"
                              ToolTip="Follow what's happening now. Scroll the graphs with the mouse wheel to look further back.">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource GoodBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LiveText" Text="Live"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="16,0,0,0"/>
        </DockPanel>

        <!-- Graphs -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="10,10,12,6">
            <Border x:Name="GraphHost"/>
        </Border>

        <!-- Moment panel: "Now" or a pinned second -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="14,12,6,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,8,2">
                    <Button x:Name="ClearPin" DockPanel.Dock="Right" Content="Clear" Padding="10,3" VerticalAlignment="Top"
                            Visibility="Collapsed" ToolTip="Stop pinning this moment and go back to live"/>
                    <StackPanel>
                        <TextBlock x:Name="MomentTitle" Text="Now" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MomentSub" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="Hover the graphs to look back. Click to pin a moment."/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="MomentSpike" DockPanel.Dock="Top" Foreground="{StaticResource BadBrush}" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,4,8,0" Visibility="Collapsed"/>
                <TextBlock x:Name="MomentTotals" DockPanel.Dock="Top" FontSize="12" Margin="0,6,8,6" TextWrapping="Wrap"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="MomentBody" Margin="0,0,8,0"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Right now -->
        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource Card}" Padding="12,10,12,6">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,4">
                    <TextBlock x:Name="AppsInfo" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                    <TextBlock Text="RIGHT NOW" Style="{StaticResource H}" Margin="0"/>
                </DockPanel>
                <DataGrid x:Name="AppsGrid" SelectionMode="Single" RowHeight="26" CanUserReorderColumns="False"
                          CanUserResizeColumns="True" CanUserSortColumns="True" EnableColumnVirtualization="False"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="App" SortMemberPath="Name" Width="*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource Muted}" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColCpu" Header="CPU" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="66"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="GPU" Binding="{Binding GpuText}" SortMemberPath="Gpu" Width="62"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Header="RAM" Binding="{Binding RamText}" SortMemberPath="Ram" Width="80"
                                            ElementStyle="{StaticResource NumCell}"/>
                        <DataGridTextColumn Binding="{Binding IoText}" SortMemberPath="Io" Width="86"
                                            ElementStyle="{StaticResource NumCell}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="I/O" ToolTip="All input/output per second: disk reads and writes, plus network and other device traffic. Windows doesn't split it per app without admin tracing."/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColVRam" Binding="{Binding VRamText}" SortMemberPath="VRam" Width="96"
                                            ElementStyle="{StaticResource NumCell}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="GPU memory" ToolTip="Dedicated video memory (VRAM) the app is using on your graphics card."/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Spikes -->
        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource Card}" Padding="12,10,6,6">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,8,4">
                    <TextBlock x:Name="SpikeCount" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                    <TextBlock Text="SPIKES" Style="{StaticResource H}" Margin="0"
                               ToolTip="Flagged when CPU stays over 85% for 3 s, memory over 90% for 5 s, a disk over 90% busy for 5 s, or one app suddenly jumps to 40%+ CPU. A busy GPU isn't flagged – games keep it near 100%."/>
                </DockPanel>
                <Grid>
                    <TextBlock x:Name="SpikesEmpty" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,4,8,0">
                        <Run Text="No spikes recorded ✓" Foreground="{StaticResource GoodBrush}" FontWeight="SemiBold"/><LineBreak/>
                        <Run Text="WinScope flags CPU over 85% for 3 s, memory over 90%, a disk flat out, or an app suddenly jumping to 40% CPU."/>
                    </TextBlock>
                    <ListBox x:Name="SpikeList" Visibility="Collapsed" VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2,6,2" Cursor="Hand" ToolTip="Click to see what was running at the peak">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding KindBrush}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Time, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding KindText, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Culprit}" Foreground="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding PeakText}" FontWeight="SemiBold" Foreground="{Binding KindBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
