<UserControl x:Class="WinScope.Modules.Events.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinScope.Modules.Events"
             xmlns:ui="clr-namespace:WinScope.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Text-like toggle for "Show details" -->
        <Style x:Key="EvLink" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="Transparent" Padding="0,2" BorderThickness="0,0,0,1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows: no selection chrome -->
        <Style x:Key="EvRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type local:DayHeaderVm}">
            <DockPanel Margin="6,16,10,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Bottom"/>
                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" FontSize="12.5"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:EventItemVm}">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="6,10,10,10">
                <Grid Opacity="{Binding RowOpacity}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" CornerRadius="10" Background="{Binding SevSoft}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding SevBrush}" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                    <StackPanel Grid.Column="2">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,1,0,0">
                                <Border Visibility="{Binding HasCount, Converter={StaticResource BoolVis}}" Background="{StaticResource Panel2}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CountText}" FontSize="11.5"/>
                                </Border>
                                <Border Visibility="{Binding IsHarmless, Converter={StaticResource BoolVis}}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" CornerRadius="9" Padding="7,0" Margin="0,0,8,0">
                                    <TextBlock Text="Harmless" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                                </Border>
                                <TextBlock Text="{Binding CategoryText}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding WindowsSays}" Visibility="{Binding HasWindowsSays, Converter={StaticResource BoolVis}}"
                                   Foreground="{StaticResource Muted}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Explain}" TextWrapping="Wrap" Foreground="#C5CDD8" Margin="0,4,0,0"/>
                        <StackPanel Visibility="{Binding HasTips, Converter={StaticResource BoolVis}}" Margin="0,7,0,0">
                            <TextBlock Text="What you can try" Foreground="{StaticResource Accent}" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TipsText}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="19"/>
                        </StackPanel>
                        <ToggleButton Style="{StaticResource EvLink}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Content="{Binding ExpandText}"
                                      HorizontalAlignment="Left" Margin="0,7,0,0"/>
                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}" Background="{StaticResource Panel2}"
                                CornerRadius="7" Padding="10,8" Margin="0,6,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Copy" VerticalAlignment="Top" Padding="10,3" Margin="10,0,0,0"
                                        Click="Copy_Click" ToolTip="Copy the title, explanation and details"/>
                                <TextBox Text="{Binding DetailsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent"
                                         BorderBrush="Transparent" Padding="0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseWheel="Details_PreviewMouseWheel"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary sentence -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="UpdatedText" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="RefreshBtn" Content="Refresh" Click="Refresh_Click" ToolTip="Check the logs for new events now"/>
                </StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="15.5" TextWrapping="Wrap" VerticalAlignment="Center"
                           ToolTip="'Up' counts from Windows' last full start. With Fast Startup on, Shut down doesn't fully restart Windows – choose Restart to start completely fresh."/>
            </DockPanel>
        </Border>

        <!-- Range, toggles, search -->
        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
            <Grid DockPanel.Dock="Right" Width="240" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" ToolTip="Search titles, explanations, sources and event IDs"/>
                <TextBlock x:Name="SearchHint" Text="Search events…" Foreground="{StaticResource Muted}" Margin="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <WrapPanel VerticalAlignment="Center">
                <RadioButton x:Name="R1" Content="Last 24 h" GroupName="evrange" Style="{StaticResource ChipRadio}" Checked="Range_Checked" Margin="0,0,6,4"/>
                <RadioButton x:Name="R7" Content="7 days" GroupName="evrange" Style="{StaticResource ChipRadio}" Checked="Range_Checked" Margin="0,0,6,4"/>
                <RadioButton x:Name="R30" Content="30 days" GroupName="evrange" Style="{StaticResource ChipRadio}" Checked="Range_Checked" Margin="0,0,18,4"/>
                <CheckBox x:Name="InfoBox" Checked="Toggle_Changed" Unchecked="Toggle_Changed" VerticalAlignment="Center" Margin="0,0,16,4"
                          ToolTip="Restarts, sleep and wake, installed updates and normal disconnects"/>
                <CheckBox x:Name="HarmlessBox" Checked="Toggle_Changed" Unchecked="Toggle_Changed" VerticalAlignment="Center" Margin="0,0,10,4"
                          ToolTip="Warnings Windows logs on almost every PC that Microsoft says are safe to ignore"/>
            </WrapPanel>
        </DockPanel>

        <!-- Category chips (built in code, with counts) -->
        <WrapPanel x:Name="CatPanel" Grid.Row="2" Margin="0,8,0,0"/>

        <!-- Notes: harmless explanation, unreadable logs, read caps -->
        <StackPanel Grid.Row="3">
            <ui:AdminNotice x:Name="Admin" Visibility="Collapsed" Margin="0,8,0,0"
                            Message="Windows wouldn't let WinScope read one of the event logs as a standard user. Restarting as administrator lets it read them."/>
            <Border x:Name="NoteBox" Visibility="Collapsed" Margin="0,6,0,0" Padding="12,7" CornerRadius="8"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <TextBlock x:Name="NoteText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/>
            </Border>
        </StackPanel>

        <!-- Timeline -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8,0,4,6" Margin="0,10,0,0">
            <Grid>
                <ListBox x:Name="List" ItemContainerStyle="{StaticResource EvRow}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False"/>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{StaticResource Muted}" MaxWidth="460" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
